# ── Database ──
# Local PostgreSQL in dev:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fintrack
#
# Supabase Session Pooler (Python):
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fintrack

# ── App Environment ──
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Authentication & JWT ──
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth 2.0 & Firebase ──
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Email / Resend / SMTP (Password Reset & Verification) ──
# Option A (Recommended for Render / Production): Resend HTTP API (Port 443)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# Option B: Standard SMTP (Local / VPS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password

# ── Rate Limiting ──
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute

# ── Cookie Configuration ──
# Blank for localhost development; set domain in production
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Data Migration (One-Time Backfill for Existing Unauthenticated Data) ──
MIGRATION_OWNER_EMAIL=owner@fintrack.local

# ── AI Engine Multi-Provider Configuration (100% Env-Driven) ──
# Supported AI_PROVIDER values: "gemini" | "claude" | "openai" | "groq" | "openrouter" | "custom"
# Option 1: Google Gemini (Recommended - Free & Vision Supported for Receipts)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_API_KEY=your-gemini-api-key-from-aistudio.google.com

# Option 2: Groq Cloud (Free & Ultra-Fast Inference)
# AI_PROVIDER=groq
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=gsk_your-groq-api-key

# Option 3: OpenAI
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-proj-your-openai-api-key

# Option 4: Anthropic Claude
# AI_PROVIDER=claude
# AI_MODEL=claude-3-5-sonnet-20241022
# AI_API_KEY=sk-ant-your-anthropic-key

# Option 5: OpenRouter (Universal Gateway)
# AI_PROVIDER=openrouter
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_API_KEY=sk-or-v1-your-openrouter-key

# Option 6: Local Ollama (Offline, Zero Cost)
# AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY=ollama
