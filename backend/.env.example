# ── Database ──
# Local PostgreSQL in dev:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fintrack
#
# Supabase Session Pooler (Python):
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fintrack

# ── App Environment ──
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Authentication & JWT ──
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth 2.0 ──
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Email / Resend / SMTP (Password Reset & Verification) ──
# Option A (Recommended for Render / Production): Resend HTTP API (Port 443)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# Option B: Standard SMTP (Local / VPS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password

# ── Rate Limiting ──
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute

# ── Cookie Configuration ──
# Blank for localhost development; set domain in production
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Data Migration (One-Time Backfill for Existing Unauthenticated Data) ──
MIGRATION_OWNER_EMAIL=owner@fintrack.local
